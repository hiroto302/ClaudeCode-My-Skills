{
  "presets": {
    "quick": {
      "scene_threshold": 0.4,
      "similarity_threshold": 0.9,
      "scale": 0.25,
      "quality": 10,
      "description": "クイック概要 - 最少フレーム・最低コスト"
    },
    "standard": {
      "scene_threshold": 0.3,
      "similarity_threshold": 0.85,
