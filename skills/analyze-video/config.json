      "quality": 8,
      "description": "標準分析 - バランス重視"
    },
    "detailed": {
      "scene_threshold": 0.2,
      "similarity_threshold": 0.75,
      "scale": 0.4,
      "quality": 5,
      "description": "詳細分析 - より多いフレーム・高品質"
    }
  },
  "defaults": {
    "preset": "standard",
    "filter_mode": "scene",
    "time_interval": 5,
    "model_for_cost": "opus"
  },
  "max_frames": 100,
  "supported_formats": [".mov", ".mp4", ".avi", ".mkv", ".webm", ".m4v"]
